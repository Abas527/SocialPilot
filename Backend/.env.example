# LLM provider: ollama | openai_compatible
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5-coder:7b
# Context window sent to Ollama (num_ctx). 8192 fits the evidence prompts on a 7B model.
LLM_NUM_CTX=8192
LLM_TIMEOUT_S=240

# Ollama
OLLAMA_HOST=http://localhost:11434

# OpenAI-compatible hosted API (only if LLM_PROVIDER=openai_compatible)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# RAG: set to 1 to use embeddings (Ollama) in addition to BM25
USE_EMBEDDINGS=0
EMBED_MODEL=nomic-embed-text

# Optional, raises GitHub rate limit (public repos only needed)
GITHUB_TOKEN=

DB_PATH=data/socialpilot.db
DEMO_SEED_ENABLED=1  # dev: shows a sample plugin/library catalog; set 0 in production
AUTH_SESSION_TTL_HOURS=24
EMAIL_VERIFICATION_TTL_HOURS=24

# Email verification provider: smtp | brevo
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
SMTP_FROM=SocialPilot <verified-sender@example.com>
SMTP_TIMEOUT_S=10
PUBLIC_API_URL=http://localhost:8000

# SMTP settings (used only when EMAIL_PROVIDER=smtp; use SSL or STARTTLS, not both)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=0
SMTP_STARTTLS=1

# HTTPS: leave off for local development; enable behind a trusted TLS proxy
HTTPS_REDIRECT=0
HSTS_MAX_AGE=31536000

# Native ETH tipping is currently Sepolia testnet only.
# Use an HTTPS Sepolia RPC provider URL; never commit provider credentials.
SEPOLIA_RPC_URL=
SEPOLIA_MIN_CONFIRMATIONS=2
TIP_INTENT_TTL_MINUTES=30
TIP_MAX_WEI=1000000000000000000

# Browser origins allowed to call the API directly (comma-separated).
# Leave empty when the frontend is served from the same origin / dev proxy.
CORS_ORIGINS=
# Per-minute limits (per IP for auth, per user for the rest). 0 disables a limit.
RATE_LIMIT_ENABLED=1
TRUST_PROXY_HEADERS=0
AUTH_RATE_LIMIT_PER_MIN=10
AI_RATE_LIMIT_PER_MIN=6
EXPORT_RATE_LIMIT_PER_MIN=10
WRITE_RATE_LIMIT_PER_MIN=60

# AI generation quality / background jobs
LLM_TEMPERATURE=0.4
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_S=1.0
AI_WORKERS=2
AI_MAX_ACTIVE_JOBS_PER_USER=2
AI_DAILY_JOB_LIMIT=60
